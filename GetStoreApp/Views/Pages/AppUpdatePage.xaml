<Page
    x:Class="GetStoreApp.Views.Pages.AppUpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:GetStoreApp.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:GetStoreApp.Extensions.DataType.Enums"
    xmlns:installcontrol="using:Windows.ApplicationModel.Store.Preview.InstallControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:GetStoreApp.Models"
    xmlns:rootservice="using:GetStoreApp.Services.Root"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <XamlUICommand x:Name="UpdateCommand" ExecuteRequested="{x:Bind OnUpdateExecuteRequested}" />
        <XamlUICommand x:Name="CancelCommand" ExecuteRequested="{x:Bind OnCancelExecuteRequested}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  应用更新控制栏  -->
        <CommandBar
            Grid.Row="0"
            Margin="24,5,22,-1"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            Background="Transparent"
            CommandBarOverflowPresenterStyle="{StaticResource CommandBarOverflowPresenterWithSystemBackdropStyle}"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="False">

            <CommandBar.Content>
                <Grid Margin="0,0,12,0">
                    <Grid
                        MinWidth="100"
                        MinHeight="32"
                        Margin="2,5,0,0"
                        HorizontalAlignment="Left">

                        <Rectangle
                            Fill="{ThemeResource PillItemBackgroundSelected}"
                            RadiusX="16"
                            RadiusY="16"
                            Stroke="{ThemeResource PillItemBorderBrushSelected}"
                            StrokeThickness="1" />

                        <TextBlock
                            Padding="16,4,16,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource PillItemForegroundSelected}"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/AppUpdate')}" />
                    </Grid>

                    <Grid HorizontalAlignment="Right">
                        <InfoBadge
                            Style="{StaticResource InformationalValueInfoBadgeStyle}"
                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/AppUpdateEmpty')}"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(AppUpdateCollection.Count), Mode=OneWay}"
                            Value="{x:Bind AppUpdateCollection.Count, Mode=OneWay}" />

                        <InfoBadge
                            Style="{StaticResource CautionValueInfoBadgeStyle}"
                            ToolTipService.ToolTip="{x:Bind x:String.Format(AppUpdateCountInfoString, AppUpdateCollection.Count), Mode=OneWay}"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(AppUpdateCollection.Count), Mode=OneWay}"
                            Value="{x:Bind AppUpdateCollection.Count, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </CommandBar.Content>

            <CommandBar.PrimaryCommands>
                <AppBarElementContainer Width="48" VerticalContentAlignment="Center">
                    <Button
                        MinHeight="36"
                        VerticalAlignment="Center"
                        Click="{x:Bind OnCheckUpdateClicked}"
                        Style="{StaticResource SubtleButtonStyle}">

                        <Grid>
                            <FontIcon
                                Grid.Column="0"
                                FontSize="16"
                                Glyph="&#xE895;"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsCheckingUpdate), Mode=OneWay}" />

                            <ProgressRing
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Visibility="{x:Bind IsCheckingUpdate, Mode=OneWay}" />
                        </Grid>

                        <ToolTipService.ToolTip>
                            <Grid>
                                <TextBlock Text="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/CheckUpdate')}" Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsCheckingUpdate), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/CheckingUpdate')}" Visibility="{x:Bind IsCheckingUpdate, Mode=OneWay}" />
                            </Grid>
                        </ToolTipService.ToolTip>
                    </Button>
                </AppBarElementContainer>

                <AppBarButton
                    Width="48"
                    Click="{x:Bind OnUpdateAllClicked}"
                    IsEnabled="{x:Bind GetCanUpdate(IsCheckingUpdate, AppUpdateCollection.Count), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/UpdateAll')}">

                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74A;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>

            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Click="{x:Bind OnOpenStoreClicked}"
                    Label="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/OpenStore')}"
                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/OpenStoreToolTip')}">

                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton
                    Click="{x:Bind OnInsiderProgramClicked}"
                    Label="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/InsiderProgram')}"
                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/InsiderProgramToolTip')}">

                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xF1AD;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1">
            <!--  应用更新状态显示栏  -->
            <Grid
                Margin="30,0,30,60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind GetAppUpdateSuccessfullyVisibility(AppUpdateResultKind, x:False), Mode=OneWay}">

                <!--  未检查更新  -->
                <StackPanel Spacing="20" Visibility="{x:Bind CheckAppUpdateResultKindVisibility(AppUpdateResultKind, enum:AppUpdateResultKind.NotCheckUpdate), Mode=OneWay}">
                    <Image
                        Width="150"
                        Height="150"
                        Source="ms-appx:///Assets/Image/NotCheckUpdate.png" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Medium"
                        Text="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/NotCheckUpdate')}"
                        TextAlignment="Center" />
                </StackPanel>

                <!--  没有可更新的应用  -->
                <StackPanel Spacing="20" Visibility="{x:Bind CheckAppUpdateResultKindVisibility(AppUpdateResultKind, enum:AppUpdateResultKind.Failed), Mode=OneWay}">
                    <Image
                        Width="150"
                        Height="150"
                        Source="ms-appx:///Assets/Image/Successfully.png" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Medium"
                        Text="{x:Bind AppUpdateFailedContent, Mode=OneWay}"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!--  应用更新结果展示项目控件  -->
            <ListView
                Padding="30,0,28,30"
                ItemsSource="{x:Bind AppUpdateCollection}"
                SelectionMode="None"
                Visibility="{x:Bind GetAppUpdateSuccessfullyVisibility(AppUpdateResultKind, x:True), Mode=OneWay}">

                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemContainerTransitions />

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:AppUpdateModel">
                        <Grid Margin="0,0,0,2">
                            <Grid
                                Height="60"
                                Padding="16,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="10"
                                CornerRadius="{StaticResource ControlCornerRadius}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Grid.Row="0"
                                    Width="30"
                                    Height="30"
                                    Margin="0,-6,0,-6"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">

                                    <ImageIcon>
                                        <ImageIcon.Source>
                                            <BitmapImage UriSource="{x:Bind LogoImage, Mode=OneWay}" />
                                        </ImageIcon.Source>
                                    </ImageIcon>
                                </Grid>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind PublisherDisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/DisplayName')}" />
                                                    <Run Text="{x:Bind DisplayName}" />
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/PublisherDisplayName')}" />
                                                    <Run Text="{x:Bind PublisherDisplayName}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Margin="0,0,16,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Spacing="2">

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        HorizontalTextAlignment="Left"
                                        Text="{x:Bind InstallInformation, Mode=OneWay}"
                                        TextAlignment="Left"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="12"
                                        Text="{x:Bind InstallSubInformation, Mode=OneWay}"
                                        TextAlignment="Left"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckAppInstallStateVisibility(AppInstallState, installcontrol:AppInstallState.Downloading), Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="3"
                                    Command="{StaticResource UpdateCommand}"
                                    CommandParameter="{x:Bind PackageFamilyName}"
                                    Content="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/Update')}"
                                    IsEnabled="{x:Bind IsOperating.Equals(x:False), Mode=OneWay}"
                                    Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsUpdating), Mode=OneWay}" />

                                <Button
                                    Grid.Column="3"
                                    Command="{StaticResource CancelCommand}"
                                    CommandParameter="{x:Bind PackageFamilyName}"
                                    Content="{x:Bind rootservice:ResourceService.GetLocalized('AppUpdate/Cancel')}"
                                    IsEnabled="{x:Bind IsOperating.Equals(x:False), Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind IsUpdating, Mode=OneWay}" />
                            </Grid>

                            <ProgressBar
                                Margin="16,0"
                                VerticalAlignment="Bottom"
                                IsIndeterminate="False"
                                Visibility="{x:Bind IsUpdating, Mode=OneWay}"
                                Value="{x:Bind PercentComplete, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
