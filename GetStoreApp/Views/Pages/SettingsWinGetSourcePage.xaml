<Page
    x:Class="GetStoreApp.Views.Pages.SettingsWinGetSourcePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:GetStoreApp.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:GetStoreApp.Models"
    xmlns:rootservice="using:GetStoreApp.Services.Root"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <XamlUICommand x:Name="RadioButtonClickCommand" ExecuteRequested="{x:Bind OnRadioButtonClickExecuteRequested}" />
        <XamlUICommand x:Name="EditCommand" ExecuteRequested="{x:Bind OnEditExecuteRequested}" />
        <XamlUICommand x:Name="RemoveDataSourceCommand" ExecuteRequested="{x:Bind OnRemoveDataSourceExecuteRequested}" />
        <XamlUICommand x:Name="RemoveDataSourcePreserveDataCommand" ExecuteRequested="{x:Bind OnRemoveDataSourcePreserveDataExecuteRequested}" />
    </Page.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  WinGet 数据源配置控制栏  -->
        <CommandBar
            Grid.Row="0"
            Margin="30,-4,22,-3"
            Padding="16,0,0,0"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Right"
            VerticalContentAlignment="Center"
            Background="Transparent"
            CommandBarOverflowPresenterStyle="{StaticResource CommandBarOverflowPresenterStyle}"
            DefaultLabelPosition="Collapsed"
            IsDynamicOverflowEnabled="False">

            <CommandBar.Content>
                <Grid Margin="0,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <InfoBadge
                        Style="{StaticResource InformationalValueInfoBadgeStyle}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/WinGetSourceCountEmpty')}"
                        Visibility="{x:Bind GetCountVisibility(WinGetSourceInternalCollection.Count, WinGetSourceCustomCollection.Count, x:True), Mode=OneWay}"
                        Value="{x:Bind GetLocalizedWinGetDataSourceCount(WinGetSourceInternalCollection.Count, WinGetSourceCustomCollection.Count), Mode=OneWay}" />

                    <InfoBadge
                        Style="{StaticResource CautionValueInfoBadgeStyle}"
                        ToolTipService.ToolTip="{x:Bind GetLocalizedWinGetDataSourceCountInfo(WinGetSourceInternalCollection.Count, WinGetSourceCustomCollection.Count), Mode=OneWay}"
                        Visibility="{x:Bind GetCountVisibility(WinGetSourceInternalCollection.Count, WinGetSourceCustomCollection.Count, x:False), Mode=OneWay}"
                        Value="{x:Bind GetLocalizedWinGetDataSourceCount(WinGetSourceInternalCollection.Count, WinGetSourceCustomCollection.Count), Mode=OneWay}" />
                </Grid>
            </CommandBar.Content>

            <CommandBar.PrimaryCommands>
                <AppBarButton
                    Width="48"
                    Click="{x:Bind OnAddNewSourceClicked}"
                    IsEnabled="{x:Bind IsLoadedCompleted, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/AddNewSource')}">

                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarButton
                    Width="48"
                    Click="{x:Bind OnRefreshClicked}"
                    IsEnabled="{x:Bind IsLoadedCompleted, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Refresh')}">

                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>

            <CommandBar.SecondaryCommands>
                <AppBarButton Click="{x:Bind OnSettingsInstructionClicked}" Label="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/SettingsInstruction')}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1">
            <!--  WinGet 数据源配置状态显示栏  -->
            <Grid
                Margin="30,0,30,60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsLoadedCompleted), Mode=OneWay}">

                <!--  正在加载中  -->
                <StackPanel Spacing="20">
                    <Image
                        Width="150"
                        Height="150"
                        Source="ms-appx:///Assets/Image/Search.png" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressRing
                            Grid.Column="0"
                            Width="30"
                            Height="30"
                            IsActive="True" />

                        <TextBlock
                            Grid.Column="1"
                            MaxWidth="800"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Medium"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/LoadingWinGetSource')}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!--  WinGet 数据源配置信息控件  -->
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled"
                Visibility="{x:Bind IsLoadedCompleted, Mode=OneWay}">

                <Grid Margin="30,0,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,5"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">

                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Medium"
                                Glyph="&#xE76C;" />

                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/InternalDataSource')}" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Height="60"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(WinGetSourceInternalCollection.Count), Mode=OneWay}">

                            <TextBlock
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/InternalDataSourceEmpty')}"
                                TextAlignment="Center" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            Margin="0,0,-2,0"
                            CornerRadius="0"
                            ItemsSource="{x:Bind WinGetSourceInternalCollection}"
                            SelectionMode="None"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(WinGetSourceInternalCollection.Count), Mode=OneWay}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:WinGetSourceModel">
                                    <Expander
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        IsExpanded="False">

                                        <Expander.Header>
                                            <Grid
                                                Height="60"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <RadioButton
                                                    Grid.Column="0"
                                                    MinWidth="0"
                                                    Margin="0,0,12,0"
                                                    Command="{StaticResource RadioButtonClickCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    IsEnabled="{x:Bind IsOperating.Equals(x:False), Mode=OneWay}">

                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <Grid>
                                                                <TextBlock Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Selected')}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/UnSelected')}" Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsSelected), Mode=OneWay}" />
                                                            </Grid>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                </RadioButton>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical">

                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        IsTextSelectionEnabled="True"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />

                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        IsTextSelectionEnabled="True"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Arguments}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />

                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock>
                                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Name')}" />
                                                                    <Run Text="{x:Bind Name}" />
                                                                </TextBlock>

                                                                <TextBlock>
                                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Arguments')}" />
                                                                    <Run Text="{x:Bind Arguments}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>

                                        <Grid
                                            Margin="40,0,0,0"
                                            ColumnSpacing="15"
                                            RowSpacing="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/SourceId')}" />

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind SourceId}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Explicit')}" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Explicit}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/TrustLevel')}" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind TrustLevel}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/LastUpdateTime')}" />

                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind LastUpdateTime}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Origin')}" />

                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Origin}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Type')}" />

                                            <TextBlock
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Type}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/AcceptSourceAgreements')}" />

                                            <TextBlock
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind AcceptSourceAgreements}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="7"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/AdditionalPackageCatalogArguments')}" />

                                            <TextBlock
                                                Grid.Row="7"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind AdditionalPackageCatalogArguments}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="8"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/AuthenticationType')}" />

                                            <TextBlock
                                                Grid.Row="8"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind AuthenticationType}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="9"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/AuthenticationAccount')}" />

                                            <TextBlock
                                                Grid.Row="9"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind AuthenticationAccount}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="10"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/PackageCatalogBackgroundUpdateInterval')}" />

                                            <TextBlock
                                                Grid.Row="10"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind PackageCatalogBackgroundUpdateInterval}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Expander>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            Grid.Row="2"
                            Margin="0,5,0,5"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="5">

                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Medium"
                                Glyph="&#xE76C;" />

                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/CustomDataSource')}" />
                        </StackPanel>

                        <Grid
                            Grid.Row="3"
                            Height="60"
                            Padding="16,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(WinGetSourceCustomCollection.Count), Mode=OneWay}">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/CustomDataSourceEmpty')}"
                                TextAlignment="Center" />
                        </Grid>

                        <ListView
                            Grid.Row="3"
                            Margin="0,0,-2,0"
                            CornerRadius="0"
                            ItemsSource="{x:Bind WinGetSourceCustomCollection}"
                            SelectionMode="None"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(WinGetSourceCustomCollection.Count), Mode=OneWay}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:WinGetSourceModel">
                                    <Expander
                                        Margin="0,0,0,2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        IsExpanded="False">

                                        <Expander.Header>
                                            <Grid
                                                Height="60"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <RadioButton
                                                    Grid.Column="0"
                                                    MinWidth="0"
                                                    Margin="0,0,12,0"
                                                    Command="{StaticResource RadioButtonClickCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    IsEnabled="{x:Bind IsOperating.Equals(x:False), Mode=OneWay}">

                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <Grid>
                                                                <TextBlock Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Selected')}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/UnSelected')}" Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsSelected), Mode=OneWay}" />
                                                            </Grid>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                </RadioButton>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical">

                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        IsTextSelectionEnabled="True"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />

                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        IsTextSelectionEnabled="True"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Arguments}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />

                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock>
                                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Name')}" />
                                                                    <Run Text="{x:Bind Name}" />
                                                                </TextBlock>

                                                                <TextBlock>
                                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Arguments')}" />
                                                                    <Run Text="{x:Bind Arguments}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                </StackPanel>

                                                <ProgressRing
                                                    Grid.Column="2"
                                                    IsActive="{x:Bind IsOperating, Mode=OneWay}"
                                                    Visibility="{x:Bind IsOperating, Mode=OneWay}" />

                                                <SplitButton
                                                    Grid.Column="3"
                                                    Margin="15,0,0,0"
                                                    Command="{StaticResource EditCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/Edit')}"
                                                    IsEnabled="{x:Bind IsOperating.Equals(x:False), Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/EditToolTip')}">

                                                    <SplitButton.Flyout>
                                                        <MenuFlyout Placement="Bottom">
                                                            <MenuFlyoutItem
                                                                Command="{StaticResource RemoveDataSourceCommand}"
                                                                CommandParameter="{x:Bind}"
                                                                IsEnabled="{x:Bind IsOperating.Equals(x:False), Mode=OneWay}"
                                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/RemoveDataSource')}">

                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>

                                                            <MenuFlyoutItem
                                                                Command="{StaticResource RemoveDataSourcePreserveDataCommand}"
                                                                CommandParameter="{x:Bind}"
                                                                IsEnabled="{x:Bind IsOperating.Equals(x:False), Mode=OneWay}"
                                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/RemoveDataSourcePreserveData')}">

                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </SplitButton.Flyout>
                                                </SplitButton>
                                            </Grid>
                                        </Expander.Header>

                                        <Grid
                                            Margin="40,0,0,0"
                                            ColumnSpacing="15"
                                            RowSpacing="3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('SettingsWinGetSource/SourceId')}" />

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind SourceId}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
