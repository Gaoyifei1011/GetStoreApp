<Page
    x:Class="GetStoreApp.Views.Pages.WinGetAppsVersionInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:GetStoreApp.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:datatemplate="using:GetStoreApp.Views.DataTemplates"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:GetStoreApp.Models"
    xmlns:rootservice="using:GetStoreApp.Services.Root"
    xmlns:text="using:Windows.UI.Text"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Grid>
        <Grid
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ColumnSpacing="16"
            Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsLoadCompleted), Mode=OneWay}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                Grid.Column="0"
                Width="50"
                Height="50"
                IsActive="{x:Bind IsLoadCompleted.Equals(x:False), Mode=OneWay}" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/LoadingInformation')}" />
        </Grid>

        <Grid Visibility="{x:Bind IsLoadCompleted, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ListView
                Grid.Column="0"
                ItemsSource="{x:Bind WinGetAppsVersionCollection}"
                SelectedItem="{x:Bind SelectedItem, Mode=OneWay}"
                SelectionChanged="{x:Bind OnSelectionChanged}"
                SelectionMode="Single">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:AvailableVersionModel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Version}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/DefaultVersion')}"
                                Visibility="{x:Bind IsDefaultVersion}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
            </ListView>

            <AppBarSeparator Grid.Column="1" Margin="0,-10,0,-10" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar
                    Grid.Row="0"
                    Margin="10,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    CommandBarOverflowPresenterStyle="{StaticResource CommandBarOverflowPresenterWithSystemBackdropStyle}"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="False">

                    <CommandBar.Content>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Bind x:String.Format(WinGetAppsVersionCountInfoString, WinGetAppsVersionCollection.Count), Mode=OneWay}" />
                    </CommandBar.Content>

                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            Click="{x:Bind OnCopyInformationClicked}"
                            Label="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/CopyInformation')}"
                            Visibility="{x:Bind GetWinGetAppsVisibility(SearchApps)}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            Click="{x:Bind OnCopyInformationClicked}"
                            Label="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/CopyInformation')}"
                            Visibility="{x:Bind GetWinGetAppsVisibility(UpgradableApps)}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>

                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            Click="{x:Bind OnDownloadClicked}"
                            Label="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/Download')}"
                            Visibility="{x:Bind GetWinGetAppsVisibility(SearchApps)}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE896;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            Click="{x:Bind OnInstallClicked}"
                            Label="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/Install')}"
                            Visibility="{x:Bind GetWinGetAppsVisibility(SearchApps)}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE710;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            Click="{x:Bind OnRepairClicked}"
                            Label="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/Repair')}"
                            Visibility="{x:Bind GetWinGetAppsVisibility(SearchApps)}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE90F;" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            Click="{x:Bind OnUpgradeClicked}"
                            Label="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/Upgrade')}"
                            Visibility="{x:Bind GetWinGetAppsVisibility(UpgradableApps)}">

                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE898;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <MenuFlyoutSeparator Grid.Row="1" />

                <ScrollViewer Grid.Row="2">
                    <Grid Margin="10,5,10,30">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            FontSize="26"
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind DisplayName, Mode=OneWay}"
                            TextWrapping="NoWrap" />

                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Description, Mode=OneWay}"
                            TextAlignment="Justify"
                            TextWrapping="Wrap" />

                        <MenuFlyoutSeparator Grid.Row="2" Margin="2,10" />

                        <ListView
                            Grid.Row="3"
                            ItemsSource="{x:Bind WinGetAppInfoCollection}"
                            SelectionMode="None"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(WinGetAppInfoCollection.Count), Mode=OneWay}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>

                            <ListView.ItemTemplateSelector>
                                <datatemplate:WinGetAppInfoTemplateSelector>
                                    <!--  字符串信息数据模板  -->
                                    <datatemplate:WinGetAppInfoTemplateSelector.StringInfoTemplate>
                                        <DataTemplate x:DataType="model:WinGetAppInfoModel">
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{x:Bind ClassName}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind StringContent}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </datatemplate:WinGetAppInfoTemplateSelector.StringInfoTemplate>

                                    <!--  链接信息数据模板  -->
                                    <datatemplate:WinGetAppInfoTemplateSelector.UriInfoTemplate>
                                        <DataTemplate x:DataType="model:WinGetAppInfoModel">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{x:Bind ClassName}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    IsTextSelectionEnabled="True"
                                                    TextWrapping="Wrap">

                                                    <Hyperlink NavigateUri="{x:Bind UriContent, Mode=OneWay}" UnderlineStyle="None">
                                                        <Run Text="{x:Bind UriContent, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </datatemplate:WinGetAppInfoTemplateSelector.UriInfoTemplate>
                                </datatemplate:WinGetAppInfoTemplateSelector>
                            </ListView.ItemTemplateSelector>
                        </ListView>

                        <MenuFlyoutSeparator
                            Grid.Row="4"
                            Margin="2,10"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(TagCollection.Count), Mode=OneWay}" />

                        <ListView
                            Grid.Row="5"
                            ItemsSource="{x:Bind TagCollection}"
                            SelectionMode="None"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(TagCollection.Count), Mode=OneWay}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>

                            <ListView.Header>
                                <TextBlock Margin="0,0,0,5" Text="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/Tag')}" />
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid
                                        Width="110"
                                        Margin="0,0,8,8"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}">

                                        <TextBlock
                                            Margin="10,5"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Text="{x:Bind}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <MenuFlyoutSeparator
                            Grid.Row="6"
                            Margin="2,10"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(DocumentationCollection.Count), Mode=OneWay}" />

                        <ListView
                            Grid.Row="7"
                            ItemsSource="{x:Bind DocumentationCollection}"
                            SelectionMode="None"
                            Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(DocumentationCollection.Count), Mode=OneWay}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>

                            <ListView.Header>
                                <TextBlock Margin="0,0,0,5" Text="{x:Bind rootservice:ResourceService.GetLocalized('WinGetAppsVersionInfo/Documention')}" />
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="text:ContentLinkInfo">
                                    <TextBlock
                                        Margin="0,0,10,0"
                                        Padding="0,8"
                                        HorizontalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap">

                                        <Hyperlink NavigateUri="{x:Bind Uri}" UnderlineStyle="None">
                                            <Run Text="{x:Bind DisplayText}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
