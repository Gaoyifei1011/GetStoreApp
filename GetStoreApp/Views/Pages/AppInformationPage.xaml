<Page
    x:Class="GetStoreApp.Views.Pages.AppInformationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="using:GetStoreApp.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:GetStoreApp.Models"
    xmlns:rootservice="using:GetStoreApp.Services.Root"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="AppDetailInfoModelDataTemplate" x:DataType="model:AppDetailInfoModel">
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{x:Bind ClassName}" />

                <TextBlock
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Content}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />

        <XamlUICommand x:Name="LaunchCommand" ExecuteRequested="{x:Bind OnLaunchExecuteRequested}" />
        <XamlUICommand x:Name="OpenFolderCommand" ExecuteRequested="{x:Bind OnOpenFolderExecuteRequested}" />
        <XamlUICommand x:Name="OpenStoreCommand" ExecuteRequested="{x:Bind OnOpenStoreExecuteRequested}" />
        <XamlUICommand x:Name="PinToDesktopCommand" ExecuteRequested="{x:Bind OnPinToDesktopExecuteRequested}" />
        <XamlUICommand x:Name="PinToStartScreenCommand" ExecuteRequested="{x:Bind OnPinToStartScreenExecuteRequested}" />
        <XamlUICommand x:Name="PinToTaskbarCommand" ExecuteRequested="{x:Bind OnPinToTaskbarExecuteRequested}" />
    </Page.Resources>

    <ScrollViewer
        Margin="0,52,0,0"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">

        <Grid Margin="0,0,0,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  应用信息  -->
            <Expander
                Grid.Row="0"
                Margin="30,0,30,2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True">

                <Expander.Header>
                    <CommandBar
                        Margin="0,0,-15,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        CommandBarOverflowPresenterStyle="{StaticResource CommandBarOverflowPresenterWithSystemBackdropStyle}"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="False">

                        <CommandBar.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontSize="16"
                                    Glyph="&#xE946;" />

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/AppInformation')}" />
                            </Grid>
                        </CommandBar.Content>

                        <CommandBar.PrimaryCommands>
                            <AppBarButton Click="{x:Bind OnCopyClicked}" Label="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/Copy')}">

                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar.PrimaryCommands>
                    </CommandBar>
                </Expander.Header>

                <!--  TODO：使用 TableView With DataTemplate 进行优化  -->
                <Grid Margin="0,0,10,0" RowSpacing="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,25,0"
                        HorizontalAlignment="Left"
                        FontSize="17"
                        Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/BasicInformation')}"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(BasicInformationCollection.Count), Mode=OneWay}" />

                    <ListView
                        Grid.Row="0"
                        Grid.Column="1"
                        ItemTemplate="{StaticResource AppDetailInfoModelDataTemplate}"
                        ItemsSource="{x:Bind BasicInformationCollection}"
                        SelectionMode="None"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(BasicInformationCollection.Count), Mode=OneWay}">

                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                    </ListView>

                    <MenuFlyoutSeparator
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(BasicInformationCollection.Count), Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,25,0"
                        HorizontalAlignment="Left"
                        FontSize="17"
                        Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PublisherInformation')}"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(PublisherInformationCollection.Count), Mode=OneWay}" />

                    <ListView
                        Grid.Row="2"
                        Grid.Column="1"
                        ItemTemplate="{StaticResource AppDetailInfoModelDataTemplate}"
                        ItemsSource="{x:Bind PublisherInformationCollection}"
                        SelectionMode="None"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(PublisherInformationCollection.Count), Mode=OneWay}">

                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                    </ListView>

                    <MenuFlyoutSeparator
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(PublisherInformationCollection.Count), Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,0,25,0"
                        HorizontalAlignment="Left"
                        FontSize="17"
                        Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PackageInformation')}"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(PackageInformationCollection.Count), Mode=OneWay}" />

                    <ListView
                        Grid.Row="4"
                        Grid.Column="1"
                        ItemTemplate="{StaticResource AppDetailInfoModelDataTemplate}"
                        ItemsSource="{x:Bind PackageInformationCollection}"
                        SelectionMode="None"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(PackageInformationCollection.Count), Mode=OneWay}">

                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                    </ListView>
                </Grid>
            </Expander>

            <!--  应用程序入口  -->
            <Expander
                Grid.Row="1"
                Margin="30,0,30,2"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True"
                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(AppListEntryCollection.Count), Mode=OneWay}">

                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            FontSize="16"
                            Glyph="&#xE8A7;" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/AppListEntry')}" />
                    </Grid>
                </Expander.Header>

                <!--  TODO：未来迁移到 TableView  -->
                <ListView
                    CornerRadius="0"
                    ItemsSource="{x:Bind AppListEntryCollection}"
                    SelectionMode="None">

                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:AppListEntryModel">
                            <Grid
                                Height="60"
                                Padding="18,0,12,0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap">

                                        <Run Text="{x:Bind Description}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind AppUserModelId}" />
                                    </TextBlock>

                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/EntryDisplayName')}" />
                                                    <Run Text="{x:Bind DisplayName}" />
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/EntryDescription')}" />
                                                    <Run Text="{x:Bind Description}" />
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/EntryAUMID')}" />
                                                    <Run Text="{x:Bind AppUserModelId}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </StackPanel>

                                <SplitButton
                                    Grid.Column="1"
                                    Command="{StaticResource LaunchCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/Launch')}">

                                    <SplitButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                Command="{StaticResource PinToDesktopCommand}"
                                                CommandParameter="{x:Bind}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PinToDesktop')}"
                                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PinToDesktopToolTip')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7F4;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem
                                                Command="{StaticResource PinToStartScreenCommand}"
                                                CommandParameter="{x:Bind}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PinToStartScreen')}"
                                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PinToStartScreenToolTip')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8FC;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem
                                                Command="{StaticResource PinToTaskbarCommand}"
                                                CommandParameter="{x:Bind}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PinToTaskbar')}"
                                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/PinToTaskbarToolTip')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE770;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>

            <!--  依赖信息  -->
            <Expander
                Grid.Row="2"
                Margin="30,0,30,0"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True"
                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(DependencyCollection.Count), Mode=OneWay}">

                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            FontSize="16"
                            Glyph="&#xE8AB;" />

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/DependencyInformation')}" />
                    </Grid>
                </Expander.Header>

                <!--  TODO：未来迁移到 TableView  -->
                <ListView
                    CornerRadius="0"
                    ItemsSource="{x:Bind DependencyCollection}"
                    SelectionMode="None">

                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:PackageModel">
                            <Grid
                                Height="60"
                                Padding="18,0,12,0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind DisplayName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap">

                                        <Run Text="{x:Bind PublisherDisplayName}" />
                                        <Run Text=" | " />
                                        <Run Text="{x:Bind Version}" />
                                    </TextBlock>

                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/DependencyDisplayName')}" />
                                                    <Run Text="{x:Bind DisplayName}" />
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/DependencyPublisherDisplayName')}" />
                                                    <Run Text="{x:Bind PublisherDisplayName}" />
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/DependencyVersion')}" />
                                                    <Run Text="{x:Bind Version}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Padding="0"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/ViewMore')}">

                                    <FontIcon FontSize="16" Glyph="&#xE712;" />

                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                Command="{StaticResource OpenStoreCommand}"
                                                CommandParameter="{x:Bind Package}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/OpenStore')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE719;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem
                                                Command="{StaticResource OpenFolderCommand}"
                                                CommandParameter="{x:Bind Package}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('AppInformation/OpenFolder')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>
