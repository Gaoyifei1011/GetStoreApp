<Page
    x:Class="GetStoreApp.Views.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:GetStoreApp.Models"
    xmlns:rootservice="using:GetStoreApp.Services.Root"
    Loaded="{x:Bind OnLoaded}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <TransitionCollection x:Name="SuppressNavigationTransitionCollection">
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <SuppressNavigationTransitionInfo />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>

        <TransitionCollection x:Name="LeftSlideNavigationTransitionCollection">
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <SlideNavigationTransitionInfo Effect="FromLeft" />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>

        <TransitionCollection x:Name="RightSlideNavigationTransitionCollection">
            <NavigationThemeTransition>
                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                    <SlideNavigationTransitionInfo Effect="FromRight" />
                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Resources>

    <SplitView
        x:Name="DownloadSplitView"
        DisplayMode="Overlay"
        OpenPaneLength="320"
        PaneBackground="Transparent"
        PanePlacement="Right">

        <Grid Margin="0,10,0,0">
            <!--  下载管理控制栏  -->
            <RadioButtons
                Margin="30,5,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Canvas.ZIndex="1"
                ItemsSource="{x:Bind DownloadSelectorRadioList}"
                MaxColumns="3"
                SelectedIndex="{x:Bind SelectedIndex, Mode=OneWay}"
                SelectionChanged="{x:Bind OnSelectionChanged}">

                <RadioButtons.Resources>
                    <Thickness x:Key="RadioButtonsTopHeaderMargin">0</Thickness>
                </RadioButtons.Resources>

                <RadioButtons.ItemTemplate>
                    <DataTemplate x:DataType="model:RadioButtonItemModel">
                        <RadioButton Content="{x:Bind SelectorName}" Style="{StaticResource PillRadioButtonStyle}" />
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>

            <!--  WinGet 程序包内容  -->
            <Frame
                x:Name="DownloadFrame"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Navigated="{x:Bind OnNavigated}"
                NavigationFailed="{x:Bind OnNavigationFailed}" />
        </Grid>

        <SplitView.Pane>
            <!--  使用说明  -->
            <Grid Margin="0,10,0,0" CornerRadius="4,0,0,0">
                <SystemBackdropElement CornerRadius="4,0,0,0" SystemBackdrop="{StaticResource AcrylicBackgroundFillColorDefaultBackdrop}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="16,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Glyph="&#xE946;" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/UseInstruction')}" />

                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="{x:Bind OnCloseClicked}"
                            Style="{StaticResource AlternateCloseButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Download/Close')}">

                            <FontIcon
                                Margin="4"
                                FontSize="16"
                                Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Visible"
                        VerticalScrollMode="Enabled">

                        <Grid Margin="0,0,0,30">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="16,10,16,10"
                                FontSize="15"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/DownloadInstruction')}"
                                TextAlignment="Left" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/DownloadInstruction1')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/DownloadInstruction2')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="3"
                                Margin="16,0,16,5"
                                FontSize="14"
                                FontWeight="Normal"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/DownloadInstruction3')}"
                                TextAlignment="Justify"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Grid.Row="4"
                                Margin="16,0,16,5"
                                Spacing="5">

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink Click="{x:Bind OnLearnMoreClicked}" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/LearnMore')}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink Click="{x:Bind OnNetworkInternetClicked}" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/NetworkAndInternet')}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock HorizontalAlignment="Left">
                                    <Hyperlink Click="{x:Bind OnOpenSettingsClicked}" UnderlineStyle="None">
                                        <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('Download/OpenSettings')}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </SplitView.Pane>
    </SplitView>
</Page>
