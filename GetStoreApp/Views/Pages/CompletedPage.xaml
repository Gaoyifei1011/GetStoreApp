<Page
    x:Class="GetStoreApp.Views.Pages.CompletedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converter="using:GetStoreApp.Helpers.Converters"
    xmlns:customcontrol="using:GetStoreApp.Views.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enum="using:GetStoreApp.Extensions.DataType.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:GetStoreApp.Models"
    xmlns:roothelper="using:GetStoreApp.Helpers.Root"
    xmlns:rootservice="using:GetStoreApp.Services.Root"
    xmlns:system="using:System"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <XamlUICommand x:Name="CopyCommand" ExecuteRequested="{x:Bind OnCopyEexeuteReqeusted}" />
        <XamlUICommand x:Name="DeleteCommand" ExecuteRequested="{x:Bind OnDeleteExecuteRequested}" />
        <XamlUICommand x:Name="FileInformationCommand" ExecuteRequested="{x:Bind OnFileInformationExecuteRequested}" />
        <XamlUICommand x:Name="InstallCommand" ExecuteRequested="{x:Bind OnInstallExecuteRequested}" />
        <XamlUICommand x:Name="OpenFolderCommand" ExecuteRequested="{x:Bind OnOpenFolderExecuteRequested}" />
        <XamlUICommand x:Name="ShowShareUICommand" ExecuteRequested="{x:Bind OnShowShareUIExecuteRequested}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  下载完成文件控制栏  -->
        <Grid
            Grid.Row="0"
            Height="60"
            Margin="30,0,30,3"
            Padding="16,8,0,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="0,0,12,0"
                FontSize="16"
                Glyph="&#xE74C;" />

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Operation')}" />
            <AppBarSeparator Grid.Column="2" Margin="10,0,10,0" />

            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/CompletedEmpty')}"
                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityReverseConvert(CompletedCollection.Count), Mode=OneWay}" />

            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{x:Bind x:String.Format(CompletedCountInfoString, CompletedCollection.Count), Mode=OneWay}"
                Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(CompletedCollection.Count), Mode=OneWay}" />

            <CommandBar
                Grid.Column="4"
                VerticalAlignment="Center"
                Background="Transparent"
                DefaultLabelPosition="Right"
                Style="{StaticResource CommandBarStyle}">

                <CommandBar.PrimaryCommands>
                    <AppBarButton
                        Click="{x:Bind OnSelectClicked}"
                        IsEnabled="{x:Bind system:Convert.ToBoolean(CompletedCollection.Count), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Select')}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/SelectToolTip')}"
                        Visibility="{x:Bind GetSelectionMode(SelectionMode, controls:ListViewSelectionMode.None), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE762;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton Label="{x:Bind rootservice:ResourceService.GetLocalized('Completed/MultiSelect')}" Visibility="{x:Bind GetSelectionMode(SelectionMode, controls:ListViewSelectionMode.Multiple), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE762;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Click="{x:Bind OnSelectAllClicked}" Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/SelectAll')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Click="{x:Bind OnSelectNoneClicked}" Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/SelectNone')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Click="{x:Bind OnSelectReverseClicked}" Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/SelectReverse')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEA98;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnDeleteSelectedClicked}"
                        IsEnabled="{x:Bind GetIsLoading(CompletedResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.GetLocalized('Completed/DeleteSelected')}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/DeleteSelectedToolTip')}"
                        Visibility="{x:Bind GetSelectionMode(SelectionMode, controls:ListViewSelectionMode.Multiple), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnCancelClicked}"
                        Label="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Cancel')}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/CancelToolTip')}"
                        Visibility="{x:Bind GetSelectionMode(SelectionMode, controls:ListViewSelectionMode.Multiple), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>

                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        IsEnabled="{x:Bind GetIsLoading(CompletedResultKind), Mode=OneWay}"
                        Label="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Share')}"
                        Visibility="{x:Bind GetSelectionMode(SelectionMode, controls:ListViewSelectionMode.Multiple), Mode=OneWay}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72D;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Resources>
                            <Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Visible</Visibility>
                        </AppBarButton.Resources>

                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="{x:Bind OnShowShareUIClicked}"
                                    Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/ShowShareUI')}"
                                    Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckShareUIVisibilityConvert()}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem Click="{x:Bind OnCopyClicked}" Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Copy')}">

                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnOpenFolderClicked}"
                        Label="{x:Bind rootservice:ResourceService.GetLocalized('Completed/OpenFolder')}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/OpenFolderToolTip')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind OnUseInstructionClicked}"
                        Label="{x:Bind rootservice:ResourceService.GetLocalized('Completed/UseInstruction')}"
                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/UseInstructionToolTip')}">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!--  下载文件状态显示栏  -->
        <Grid
            Grid.Row="1"
            Height="60"
            Margin="30,0,30,0"
            Padding="16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind GetCompletedSuccessfullyState(CompletedResultKind, x:False), Mode=OneWay}">

            <Grid>
                <!--  正在加载中  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind CheckCompletedState(CompletedResultKind, enum:CompletedResultKind.Loading), Mode=OneWay}">

                    <ProgressRing IsActive="True" IsEnabled="True" />

                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/LoadingFile')}"
                        TextAlignment="Center" />
                </StackPanel>

                <!--  下载已完成列表为空  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/CompletedEmptyDescription')}"
                    TextAlignment="Center"
                    Visibility="{x:Bind CheckCompletedState(CompletedResultKind, enum:CompletedResultKind.Empty), Mode=OneWay}" />
            </Grid>
        </Grid>

        <ListView
            x:Name="CompletedListView"
            Grid.Row="2"
            Padding="30,0,30,30"
            ItemsSource="{x:Bind CompletedCollection}"
            SelectionMode="{x:Bind SelectionMode, Mode=OneWay}"
            Visibility="{x:Bind GetCompletedSuccessfullyState(CompletedResultKind, x:True), Mode=OneWay}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                    <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource ListViewItemForeground}" />
                    <Setter Property="TabNavigation" Value="Local" />
                    <Setter Property="IsHoldingEnabled" Value="True" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="MinWidth" Value="{ThemeResource ListViewItemMinWidth}" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="AllowDrop" Value="False" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                    <Setter Property="FocusVisualMargin" Value="1" />
                    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ListViewItemFocusVisualPrimaryBrush}" />
                    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ListViewItemFocusVisualSecondaryBrush}" />
                    <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <customcontrol:BorderedListViewItemPresenter
                                    x:Name="Root"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CheckBoxBorderBrush="{ThemeResource ListViewItemCheckBoxBorderBrush}"
                                    CheckBoxBrush="{ThemeResource ListViewItemCheckBoxBrush}"
                                    CheckBoxCornerRadius="{ThemeResource ListViewItemCheckBoxCornerRadius}"
                                    CheckBoxDisabledBorderBrush="{ThemeResource ListViewItemCheckBoxDisabledBorderBrush}"
                                    CheckBoxDisabledBrush="{ThemeResource ListViewItemCheckBoxDisabledBrush}"
                                    CheckBoxPointerOverBorderBrush="{ThemeResource ListViewItemCheckBoxPointerOverBorderBrush}"
                                    CheckBoxPointerOverBrush="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                    CheckBoxPressedBorderBrush="{ThemeResource ListViewItemCheckBoxPressedBorderBrush}"
                                    CheckBoxPressedBrush="{ThemeResource ListViewItemCheckBoxPressedBrush}"
                                    CheckBoxSelectedBrush="{ThemeResource ListViewItemCheckBoxSelectedBrush}"
                                    CheckBoxSelectedDisabledBrush="{ThemeResource ListViewItemCheckBoxSelectedDisabledBrush}"
                                    CheckBoxSelectedPointerOverBrush="{ThemeResource ListViewItemCheckBoxSelectedPointerOverBrush}"
                                    CheckBoxSelectedPressedBrush="{ThemeResource ListViewItemCheckBoxSelectedPressedBrush}"
                                    CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                                    CheckDisabledBrush="{ThemeResource ListViewItemCheckDisabledBrush}"
                                    CheckMode="{ThemeResource ListViewItemCheckMode}"
                                    CheckPressedBrush="{ThemeResource ListViewItemCheckPressedBrush}"
                                    ContentMargin="{TemplateBinding Padding}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    Control.IsTemplateFocusTarget="True"
                                    CornerRadius="{ThemeResource ListViewItemCornerRadius}"
                                    DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                    DragBackground="{ThemeResource ListViewItemDragBackground}"
                                    DragForeground="{ThemeResource ListViewItemDragForeground}"
                                    DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                                    FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                    FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                    FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                    FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                    FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                    FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                    FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                    PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                                    PointerOverBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                    PressedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                    SelectedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    SelectedDisabledBackground="{ThemeResource ListViewItemBackgroundSelectedDisabled}"
                                    SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                    SelectedPointerOverBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    SelectedPressedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    SelectionCheckMarkVisualEnabled="{ThemeResource ListViewItemSelectionCheckMarkVisualEnabled}"
                                    SelectionIndicatorBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                    SelectionIndicatorCornerRadius="{ThemeResource ListViewItemSelectionIndicatorCornerRadius}"
                                    SelectionIndicatorDisabledBrush="{ThemeResource ListViewItemSelectionIndicatorDisabledBrush}"
                                    SelectionIndicatorPointerOverBrush="{ThemeResource ListViewItemSelectionIndicatorPointerOverBrush}"
                                    SelectionIndicatorPressedBrush="{ThemeResource ListViewItemSelectionIndicatorPressedBrush}"
                                    SelectionIndicatorVisualEnabled="{ThemeResource ListViewItemSelectionIndicatorVisualEnabled}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ItemsControl.ItemContainerTransitions>
                <TransitionCollection />
            </ItemsControl.ItemContainerTransitions>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:CompletedModel">
                    <Grid Height="60" Padding="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="0"
                            Width="30"
                            Height="30"
                            Margin="0,0,12,0"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">

                            <ImageIcon Source="{x:Bind IconImage, Mode=OneWay}" />
                        </Grid>

                        <Grid
                            Grid.Column="1"
                            Margin="0,-4,10,0"
                            VerticalAlignment="Center"
                            RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="FileNameText"
                                    Grid.Column="0"
                                    MinWidth="50"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{x:Bind FileName}"
                                    TextAlignment="Left"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">

                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind FileName}" Visibility="{Binding ElementName=FileNameText, Path=IsTextTrimmed, Mode=OneWay}" />
                                    </ToolTipService.ToolTip>
                                </TextBlock>

                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="50"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{x:Bind roothelper:VolumeSizeHelper.ConvertVolumeSizeToString(TotalSize), Mode=OneWay}"
                                    TextAlignment="Right">

                                    <ToolTipService.ToolTip>
                                        <ToolTip>
                                            <TextBlock>
                                                <Run Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/FileSize')}" />
                                                <Run Text="{x:Bind roothelper:VolumeSizeHelper.ConvertVolumeSizeToString(TotalSize), Mode=OneWay}" />
                                            </TextBlock>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                MinWidth="50"
                                Margin="0,-3,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/DownloadCompleted')}"
                                TextAlignment="Left"
                                Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsInstalling), Mode=OneWay}" />

                            <Grid
                                x:Name="InstallInfo"
                                Grid.Row="1"
                                x:Load="{x:Bind IsInstalling, Mode=OneWay}"
                                ColumnSpacing="10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    MinWidth="50"
                                    Margin="0,-3,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Installing')}"
                                    TextAlignment="Left" />

                                <ProgressBar
                                    Grid.Column="1"
                                    IsIndeterminate="{x:Bind IsInstallWaiting, Mode=OneWay}"
                                    ShowError="{x:Bind InstallFailed, Mode=OneWay}"
                                    Value="{x:Bind InstallProgressValue, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="50"
                                    Margin="0,-3,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind InstallStateString, Mode=OneWay}"
                                    TextAlignment="Left"
                                    Visibility="{x:Bind IsInstalling, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <ContentControl
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind x:Object.Equals(SelectionMode, controls:ListViewSelectionMode.None), Mode=OneWay}">

                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    Command="{StaticResource InstallCommand}"
                                    CommandParameter="{x:Bind}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    IsEnabled="{x:Bind IsInstalling.Equals(x:False), Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Install')}">

                                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                                </Button>

                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    Command="{StaticResource OpenFolderCommand}"
                                    CommandParameter="{x:Bind FilePath}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/OpenFolder')}">

                                    <FontIcon FontSize="14" Glyph="&#xEC50;" />
                                </Button>

                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/ViewMore')}">

                                    <FontIcon FontSize="14" Glyph="&#xE712;" />

                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                Command="{StaticResource DeleteCommand}"
                                                CommandParameter="{x:Bind}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Delete')}"
                                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('Completed/DeleteToolTip')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutSubItem Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Share')}">

                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xE72D;" />
                                                </MenuFlyoutSubItem.Icon>

                                                <MenuFlyoutSubItem.Items>
                                                    <MenuFlyoutItem
                                                        Command="{StaticResource ShowShareUICommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/ShowShareUI')}"
                                                        Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckShareUIVisibilityConvert()}">

                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE70A;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>

                                                    <MenuFlyoutItem
                                                        Command="{StaticResource CopyCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/Copy')}">

                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8C8;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyoutSubItem.Items>
                                            </MenuFlyoutSubItem>

                                            <MenuFlyoutItem
                                                Command="{StaticResource FileInformationCommand}"
                                                CommandParameter="{x:Bind}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('Completed/FileInformation')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE946;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </ContentControl>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
