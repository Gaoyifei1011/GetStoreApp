<UserControl
    x:Class="GetStoreApp.Views.UserControls.QueryLinksResultUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converter="using:GetStoreApp.Helpers.Converters"
    xmlns:customcontrol="using:GetStoreApp.Views.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:GetStoreApp.Models"
    xmlns:rootservice="using:GetStoreApp.Services.Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />

        <XamlUICommand x:Name="DownloadCommand" ExecuteRequested="{x:Bind OnDownloadExecuteRequested}" />
        <XamlUICommand x:Name="OpenLinkCommand" ExecuteRequested="{x:Bind OnOpenLinkExecuteRequested}" />
        <XamlUICommand x:Name="CopyLinkCommand" ExecuteRequested="{x:Bind OnCopyLinkExecuteRequested}" />
        <XamlUICommand x:Name="CopyInformationCommand" ExecuteRequested="{x:Bind OnCopyInformationExecuteRequested}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  查询链接结果显示栏  -->
        <InfoBar
            Grid.Row="0"
            Margin="30,5,30,3"
            IsClosable="False"
            IsIconVisible="False"
            IsOpen="True"
            Severity="Success">

            <Grid
                Height="60"
                Padding="0,8,0,8"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    FontSize="16"
                    Glyph="&#xE71E;" />

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/QueryResult')}" />

                <AppBarSeparator Grid.Column="2" Margin="10,0,10,0" />

                <StackPanel Grid.Column="3" VerticalAlignment="Center">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/QueriedAppType')}" />

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/NonPackagedApp')}"
                            Visibility="{x:Bind converter:ValueConverterHelper.BooleanToVisibilityReverseConvert(IsPackagedApp), Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/PackagedApp')}"
                            Visibility="{x:Bind IsPackagedApp, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Text="{x:Bind x:String.Format(QueryLinksResultCountInfoString, QueryLinksResultCollection.Count), Mode=OneWay}" />
                </StackPanel>

                <CommandBar
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DefaultLabelPosition="Right">

                    <CommandBar.PrimaryCommands>
                        <AppBarButton Click="{x:Bind OnBackToHomePageClicked}" Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/BackToHomePage')}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE845;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>
        </InfoBar>

        <!--  查询链接结果  -->
        <ScrollViewer
            Grid.Row="1"
            Padding="30,0,30,0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">

            <Grid Margin="0,0,0,30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  查询链接结果信息栏  -->
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind IsAppInfoVisible, Mode=OneWay}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Height="50"
                        Padding="16,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            FontSize="16"
                            Glyph="&#xE946;" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/QueriedAppInfo')}" />

                        <CommandBar
                            Grid.Column="2"
                            Margin="0,0,-15,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            Style="{StaticResource CommandBarStyle}">

                            <CommandBar.PrimaryCommands>
                                <AppBarButton Click="{x:Bind OnCopyQueriedAppInfoClicked}" Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopyQueriedAppInfo')}">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>

                                <AppBarButton Click="{x:Bind OnLearnMoreClicked}" Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/LearnMore')}">
                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE890;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Padding="44,16,26,16"
                        RowSpacing="6">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/QueriedAppName')}" />

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind AppInfo.Name, Mode=OneWay}"
                            TextAlignment="Justify"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/QueriedAppPublisher')}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind AppInfo.Publisher, Mode=OneWay}"
                            TextAlignment="Justify"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/QueriedAppDescription')}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind AppInfo.Description, Mode=OneWay}"
                            TextAlignment="Justify"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>

                <!--  查询链接结果列表  -->
                <Grid
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="{StaticResource ControlCornerRadius}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Height="50"
                        Padding="16,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            FontSize="16"
                            Glyph="&#xE8FD;" />

                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/FileList')}" />

                        <CommandBar
                            x:Name="NormalModeCommandBar"
                            Grid.Column="2"
                            Margin="0,0,-15,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            Style="{StaticResource CommandBarStyle}"
                            Visibility="{x:Bind GetSelectionMode(SelectionMode, controls:ListViewSelectionMode.None), Mode=OneWay}">

                            <CommandBar.PrimaryCommands>
                                <AppBarButton
                                    Click="{x:Bind OnSelectClicked}"
                                    Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/Select')}"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/SelectToolTip')}">

                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE762;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.PrimaryCommands>
                        </CommandBar>

                        <CommandBar
                            x:Name="SelectionModeCommandBar"
                            Grid.Column="2"
                            Margin="0,0,-15,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            Style="{StaticResource CommandBarStyle}"
                            Visibility="{x:Bind GetSelectionMode(SelectionMode, controls:ListViewSelectionMode.Multiple), Mode=OneWay}">

                            <CommandBar.PrimaryCommands>
                                <AppBarButton Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/MultiSelect')}">

                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE762;" />
                                    </AppBarButton.Icon>

                                    <AppBarButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Click="{x:Bind OnSelectAllClicked}" Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/SelectAll')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B3;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem Click="{x:Bind OnSelectNoneClicked}" Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/SelectNone')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8E6;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem Click="{x:Bind OnSelectReverseClicked}" Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/SelectReverse')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEA98;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>

                                <AppBarButton Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/Copy')}" ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopyToolTip')}">

                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </AppBarButton.Icon>

                                    <AppBarButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                Click="{x:Bind OnCopySelectedLinkClicked}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopySelectedLink')}"
                                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopySelectedLinkToolTip')}" />

                                            <MenuFlyoutItem
                                                Click="{x:Bind OnCopySelectedClicked}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopySelectedContent')}"
                                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopySelectedContentToolTip')}" />
                                        </MenuFlyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>

                                <AppBarButton Click="{x:Bind OnDownloadClicked}" Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/Download')}">

                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE74B;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>

                                <AppBarButton
                                    Click="{x:Bind OnCancelClicked}"
                                    Label="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/Cancel')}"
                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CancelToolTip')}">

                                    <AppBarButton.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                    </Grid>

                    <ListView
                        x:Name="QueryLinksResultListView"
                        Grid.Row="1"
                        CornerRadius="0"
                        ItemsSource="{x:Bind QueryLinksResultCollection}"
                        SelectionMode="{x:Bind SelectionMode, Mode=OneWay}"
                        Visibility="{x:Bind converter:ValueConverterHelper.IntToVisibilityConvert(QueryLinksResultCollection.Count), Mode=OneWay}">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{ThemeResource ListViewItemForeground}" />
                                <Setter Property="TabNavigation" Value="Local" />
                                <Setter Property="IsHoldingEnabled" Value="True" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="MinWidth" Value="{ThemeResource ListViewItemMinWidth}" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="AllowDrop" Value="False" />
                                <Setter Property="UseSystemFocusVisuals" Value="True" />
                                <Setter Property="FocusVisualMargin" Value="1" />

                                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ListViewItemFocusVisualPrimaryBrush}" />
                                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ListViewItemFocusVisualSecondaryBrush}" />
                                <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <customcontrol:BorderedListViewItemPresenter
                                                x:Name="Root"
                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                CheckBoxBorderBrush="{ThemeResource ListViewItemCheckBoxBorderBrush}"
                                                CheckBoxBrush="{ThemeResource ListViewItemCheckBoxBrush}"
                                                CheckBoxCornerRadius="{ThemeResource ListViewItemCheckBoxCornerRadius}"
                                                CheckBoxDisabledBorderBrush="{ThemeResource ListViewItemCheckBoxDisabledBorderBrush}"
                                                CheckBoxDisabledBrush="{ThemeResource ListViewItemCheckBoxDisabledBrush}"
                                                CheckBoxPointerOverBorderBrush="{ThemeResource ListViewItemCheckBoxPointerOverBorderBrush}"
                                                CheckBoxPointerOverBrush="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                                CheckBoxPressedBorderBrush="{ThemeResource ListViewItemCheckBoxPressedBorderBrush}"
                                                CheckBoxPressedBrush="{ThemeResource ListViewItemCheckBoxPressedBrush}"
                                                CheckBoxSelectedBrush="{ThemeResource ListViewItemCheckBoxSelectedBrush}"
                                                CheckBoxSelectedDisabledBrush="{ThemeResource ListViewItemCheckBoxSelectedDisabledBrush}"
                                                CheckBoxSelectedPointerOverBrush="{ThemeResource ListViewItemCheckBoxSelectedPointerOverBrush}"
                                                CheckBoxSelectedPressedBrush="{ThemeResource ListViewItemCheckBoxSelectedPressedBrush}"
                                                CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                                                CheckDisabledBrush="{ThemeResource ListViewItemCheckDisabledBrush}"
                                                CheckMode="{ThemeResource ListViewItemCheckMode}"
                                                CheckPressedBrush="{ThemeResource ListViewItemCheckPressedBrush}"
                                                ContentMargin="{TemplateBinding Padding}"
                                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                                Control.IsTemplateFocusTarget="True"
                                                CornerRadius="0"
                                                DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                                DragBackground="{ThemeResource ListViewItemDragBackground}"
                                                DragForeground="{ThemeResource ListViewItemDragForeground}"
                                                DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                                                FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                                FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                                FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                                FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                                FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                                FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                                FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                                PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                                                PointerOverBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                                PressedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                SelectedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                SelectedDisabledBackground="{ThemeResource ListViewItemBackgroundSelectedDisabled}"
                                                SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                                SelectedPointerOverBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                SelectedPressedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                SelectionCheckMarkVisualEnabled="{ThemeResource ListViewItemSelectionCheckMarkVisualEnabled}"
                                                SelectionIndicatorBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                                SelectionIndicatorCornerRadius="{ThemeResource ListViewItemSelectionIndicatorCornerRadius}"
                                                SelectionIndicatorDisabledBrush="{ThemeResource ListViewItemSelectionIndicatorDisabledBrush}"
                                                SelectionIndicatorPointerOverBrush="{ThemeResource ListViewItemSelectionIndicatorPointerOverBrush}"
                                                SelectionIndicatorPressedBrush="{ThemeResource ListViewItemSelectionIndicatorPressedBrush}"
                                                SelectionIndicatorVisualEnabled="{ThemeResource ListViewItemSelectionIndicatorVisualEnabled}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection />
                        </ItemsControl.ItemContainerTransitions>

                        <ListView.Header>
                            <ListView ItemContainerTransitions="{x:Bind QueryLinksResultListView.ItemContainerTransitions, Mode=OneWay}" SelectionMode="{x:Bind QueryLinksResultListView.SelectionMode, Mode=OneWay}">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                                        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{ThemeResource ListViewItemForeground}" />
                                        <Setter Property="TabNavigation" Value="Local" />
                                        <Setter Property="IsHoldingEnabled" Value="True" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="MinWidth" Value="{ThemeResource ListViewItemMinWidth}" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="AllowDrop" Value="False" />
                                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                                        <Setter Property="FocusVisualMargin" Value="1" />
                                        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource ListViewItemFocusVisualPrimaryBrush}" />
                                        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                                        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource ListViewItemFocusVisualSecondaryBrush}" />
                                        <Setter Property="FocusVisualSecondaryThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <customcontrol:BorderedListViewItemPresenter
                                                        x:Name="Root"
                                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        CheckBoxBorderBrush="Transparent"
                                                        CheckBoxBrush="Transparent"
                                                        CheckBoxCornerRadius="0"
                                                        CheckBoxDisabledBorderBrush="Transparent"
                                                        CheckBoxDisabledBrush="Transparent"
                                                        CheckBoxPointerOverBorderBrush="Transparent"
                                                        CheckBoxPointerOverBrush="Transparent"
                                                        CheckBoxPressedBorderBrush="Transparent"
                                                        CheckBoxPressedBrush="Transparent"
                                                        CheckBoxSelectedBrush="Transparent"
                                                        CheckBoxSelectedDisabledBrush="Transparent"
                                                        CheckBoxSelectedPointerOverBrush="Transparent"
                                                        CheckBoxSelectedPressedBrush="Transparent"
                                                        CheckBrush="{ThemeResource ListViewItemCheckBrush}"
                                                        CheckDisabledBrush="{ThemeResource ListViewItemCheckDisabledBrush}"
                                                        CheckMode="{ThemeResource ListViewItemCheckMode}"
                                                        CheckPressedBrush="{ThemeResource ListViewItemCheckPressedBrush}"
                                                        ContentMargin="{TemplateBinding Padding}"
                                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                                        Control.IsTemplateFocusTarget="True"
                                                        CornerRadius="0"
                                                        DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                                        DragBackground="{ThemeResource ListViewItemDragBackground}"
                                                        DragForeground="{ThemeResource ListViewItemDragForeground}"
                                                        DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                                                        FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"
                                                        FocusSecondaryBorderBrush="{ThemeResource ListViewItemFocusSecondaryBorderBrush}"
                                                        FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                                        FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                                        FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                                        FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                                        FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                                        PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackground}"
                                                        PointerOverBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        PointerOverForeground="{ThemeResource ListViewItemForegroundPointerOver}"
                                                        PressedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                                                        SelectedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        SelectedDisabledBackground="{ThemeResource ListViewItemBackgroundSelectedDisabled}"
                                                        SelectedForeground="{ThemeResource ListViewItemForegroundSelected}"
                                                        SelectedPointerOverBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        SelectedPressedBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        SelectionCheckMarkVisualEnabled="{ThemeResource ListViewItemSelectionCheckMarkVisualEnabled}"
                                                        SelectionIndicatorBrush="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                                        SelectionIndicatorCornerRadius="{ThemeResource ListViewItemSelectionIndicatorCornerRadius}"
                                                        SelectionIndicatorDisabledBrush="{ThemeResource ListViewItemSelectionIndicatorDisabledBrush}"
                                                        SelectionIndicatorPointerOverBrush="{ThemeResource ListViewItemSelectionIndicatorPointerOverBrush}"
                                                        SelectionIndicatorPressedBrush="{ThemeResource ListViewItemSelectionIndicatorPressedBrush}"
                                                        SelectionIndicatorVisualEnabled="{ThemeResource ListViewItemSelectionIndicatorVisualEnabled}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListViewItem>
                                    <Grid
                                        Height="35"
                                        Padding="6,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            x:Name="FileNameHeaderTextBlock"
                                            Grid.Column="0"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/FileName')}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/FileName')}" Visibility="{x:Bind FileNameHeaderTextBlock.IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            x:Name="FileSizeHeaderTextBlock"
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/FileSize')}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/FileSize')}" Visibility="{x:Bind FileSizeHeaderTextBlock.IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/Options')}"
                                            ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/OptionsToolTip')}" />
                                    </Grid>
                                </ListViewItem>
                            </ListView>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="model:QueryLinksResultModel">
                                <Grid Height="35" Padding="6,0,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <HyperlinkButton
                                        Grid.Column="0"
                                        Margin="10,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{StaticResource DownloadCommand}"
                                        CommandParameter="{x:Bind}"
                                        Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckListViewSelectionMode(SelectionMode, controls:ListViewSelectionMode.None), Mode=OneWay}">

                                        <HyperlinkButton.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary x:Key="Default">
                                                    <StaticResource x:Key="HyperlinkButtonForegroundDisabled" ResourceKey="TextFillColorPrimaryBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast">
                                                    <StaticResource x:Key="HyperlinkButtonForegroundDisabled" ResourceKey="SystemColorButtonTextColorBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="HyperlinkButtonForegroundDisabled" ResourceKey="TextFillColorPrimaryBrush" />
                                                </ResourceDictionary>
                                            </ResourceDictionary>
                                        </HyperlinkButton.Resources>

                                        <TextBlock
                                            x:Name="FileNameHyperTextBlock"
                                            HorizontalAlignment="Left"
                                            Text="{x:Bind FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">

                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="{x:Bind FileName}" Visibility="{Binding ElementName=FileNameHyperTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                            </ToolTipService.ToolTip>
                                        </TextBlock>

                                        <HyperlinkButton.ContextFlyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem
                                                    Command="{StaticResource CopyLinkCommand}"
                                                    CommandParameter="{x:Bind FileLink}"
                                                    IsEnabled="{x:Bind x:Object.Equals(SelectionMode, controls:ListViewSelectionMode.None), Mode=OneWay}"
                                                    Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopyLink')}"
                                                    ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopyLinkToolTip')}">

                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </HyperlinkButton.ContextFlyout>
                                    </HyperlinkButton>

                                    <TextBlock
                                        x:Name="FileNameTextBlock"
                                        Grid.Column="0"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind converter:ValueCheckConverterHelper.CheckListViewSelectionMode(SelectionMode, controls:ListViewSelectionMode.Multiple), Mode=OneWay}">

                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{x:Bind FileName}" Visibility="{Binding ElementName=FileNameTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                        </ToolTipService.ToolTip>
                                    </TextBlock>

                                    <TextBlock
                                        x:Name="FileSizeTextBlock"
                                        Grid.Column="1"
                                        MinWidth="50"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind FileSize}"
                                        TextAlignment="Left"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap">

                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{x:Bind FileSize}" Visibility="{Binding ElementName=FileSizeTextBlock, Path=IsTextTrimmed, Mode=OneWay}" />
                                        </ToolTipService.ToolTip>
                                    </TextBlock>

                                    <HyperlinkButton
                                        Grid.Column="2"
                                        Margin="0,0,5,0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Command="{StaticResource OpenLinkCommand}"
                                        CommandParameter="{x:Bind FileLink}"
                                        Content="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/OpenLink')}"
                                        IsEnabled="{x:Bind x:Object.Equals(SelectionMode, controls:ListViewSelectionMode.None), Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/OpenLinkToolTip')}" />

                                    <Grid.ContextFlyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                Command="{StaticResource CopyInformationCommand}"
                                                CommandParameter="{x:Bind}"
                                                IsEnabled="{x:Bind x:Object.Equals(SelectionMode, controls:ListViewSelectionMode.None), Mode=OneWay}"
                                                Text="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopyInformation')}"
                                                ToolTipService.ToolTip="{x:Bind rootservice:ResourceService.GetLocalized('QueryLinksResult/CopyInformationToolTip')}">

                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
